# Bandit configuration - keeps local `bandit -r .` runs in sync with CI.
# Excludes the vendored virtualenv and tests, which intentionally exercise
# subprocess / unsafe-by-design code paths.

exclude_dirs:
  - venv
  - .git
  - tests
  - scripts
  - ci_artifacts

# Reviewed and accepted findings:
# B311 random - used only for jitter / sample IDs, not security tokens.
# B108 hardcoded tmp directory - used as literal risk indicators, not paths.
#
# Removed from the global skip list (was masking real risk across the
# tree — re-enable per-line with `# nosec B603` only where audited):
#   B404 import subprocess
#   B603 subprocess-without-shell-equals-true
#   B607 partial-path
#
# B602 (shell=True) is INTENTIONALLY left in the gate so any future
# `subprocess.Popen(..., shell=True)` slips into CI as a failure.
skips:
  - B311
  - B108
