# ShadowLab secure local example configuration
# Copy to .env or export manually before starting the API.

# Bind locally by default
SHADOWLAB_HOST=127.0.0.1
SHADOWLAB_PORT=8000

# Require authentication
SHADOWLAB_REQUIRE_AUTH=true
SHADOWLAB_REQUIRE_TLS=true
SHADOWLAB_SIGNED_REQUEST_WINDOW_SECONDS=60
# Only set this when running behind a trusted reverse proxy.
# SHADOWLAB_TRUSTED_PROXIES=127.0.0.1

# Preferred: store SHA-256 hashes instead of raw API keys
SHADOWLAB_API_KEYS_SHA256=viewer:<viewer_sha256>,analyst:<analyst_sha256>,admin:<admin_sha256>

# Optional single-key mode. Defaults to least privilege unless explicitly overridden.
# SHADOWLAB_API_KEY_SHA256=<single_key_sha256>
# SHADOWLAB_API_KEY_ROLE=viewer

# Allow only trusted frontend origins
SHADOWLAB_ALLOWED_ORIGINS=http://127.0.0.1,http://localhost

# Dangerous/destructive capabilities are disabled by default
SHADOWLAB_ENABLE_DANGEROUS_ACTIONS=false
SHADOWLAB_ENABLE_NETWORK_WARFARE=false
SHADOWLAB_ALLOW_FILE_DELETE=false

# Enterprise policy profile: lab | corp | prod
SHADOWLAB_POLICY_PROFILE=lab

# Connector delivery worker (auto retry queue processor)
SHADOWLAB_CONNECTOR_QUEUE_WORKER=true
SHADOWLAB_CONNECTOR_QUEUE_INTERVAL_SECONDS=20

# Optional webhook configured at runtime or here
# SHADOWLAB_ALERT_WEBHOOK=https://example.com/webhook
