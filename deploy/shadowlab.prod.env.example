# ShadowLab production/corporate environment template
# Replace placeholder digests and hostnames before use.

SHADOWLAB_HOST=127.0.0.1
SHADOWLAB_PORT=8000

SHADOWLAB_REQUIRE_AUTH=true
SHADOWLAB_REQUIRE_TLS=true
SHADOWLAB_POLICY_PROFILE=corp
SHADOWLAB_SIGNED_REQUEST_WINDOW_SECONDS=60

# Generate role secrets with: python scripts/generate_api_keys.py
SHADOWLAB_API_KEYS_SHA256=viewer:<viewer_sha256>,analyst:<analyst_sha256>,admin:<admin_sha256>

# Set this only when running behind a known reverse proxy or load balancer.
SHADOWLAB_TRUSTED_PROXIES=127.0.0.1

# Prefer explicit frontend origins; do not use * in corp/prod.
SHADOWLAB_ALLOWED_ORIGINS=https://shadowlab.example.com

SHADOWLAB_ENABLE_DANGEROUS_ACTIONS=false
SHADOWLAB_ENABLE_NETWORK_WARFARE=false
SHADOWLAB_ALLOW_FILE_DELETE=false

# Database
# SHADOWLAB_DATABASE_URL=postgresql://shadowlab:<password>@db.internal:5432/shadowlab

# Optional OIDC
# SHADOWLAB_OIDC_ISSUER_URL=https://id.example.com/
# SHADOWLAB_OIDC_AUDIENCE=shadowlab-api

# Optional integration paths
# SHADOWLAB_OSSEC_HOME=C:\Program Files\ossec-agent

# Logging
SHADOWLAB_LOG_LEVEL=INFO
